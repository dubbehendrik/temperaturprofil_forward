{
  "name": "Temperaturprofil Forward",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]},
    "codespaces": {"openFiles": ["README.md", "streamlit_temperaturprofil_forward_app.py"]}
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": {"server": "streamlit run streamlit_temperaturprofil_forward_app.py --server.address 0.0.0.0"},
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "Temperaturprofil Forward", "onAutoForward": "openPreview"}}
}
